# run-kit configuration
# Override locally via .env.local (gitignored)

# The port you open in your browser.
# Dev mode: Vite serves on this port, Go backend on PORT+1.
# Prod mode: Go backend serves on this port directly.
RK_PORT=3000
RK_HOST=0.0.0.0

# Optional: the SSH host alias remote clients use to reach this host
# (as configured in their ~/.ssh/config). Enables the Open button's editor
# ssh-remote deeplinks (VS Code / Cursor / Windsurf) for remote viewers.
# Unset: the deeplink section is hidden.
# RK_SSH_HOST=my-host

# Optional: code-server port for the right-panel CODE surface / `?view=code` lens.
# Unset = feature off everywhere (no rail button, no switcher segment). The embed
# rides the same-origin relative /proxy/{port}/ path, so this is a PORT, not a URL.
# STATE IDENTITY: code-server keys browser-side workspace state (open tabs, layout)
# by the proxy pathname — a port that drifts across restarts silently blanks every
# user's workspace. Pick one port and keep it stable.
# RK_CODE_SERVER_PORT=8080
