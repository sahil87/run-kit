{
  "$comment": "Shared accept/reject corpus for the layout leaf grammar, consumed by the Vitest suite (layout-tree.test.ts) and the Go layoutspec tests (which read this file via a relative path). Semantics: parse `input`; accept = parse succeeds AND canonical validation passes (with `owner` as the owning window id when present). `expect` is the serialized form of the accepted parse (required when accept is true); validation never normalises, so it always equals `input` for the tree grammar and is the converted tree for legacy presets.",
  "grammar": [
    { "input": "tty", "accept": true, "expect": "tty" },
    { "input": "@12/tty", "accept": true, "expect": "@12/tty" },
    { "input": "@12/web", "accept": true, "expect": "@12/web" },
    { "input": "h(tty,v(@12/tty,web))", "accept": true, "expect": "h(tty,v(@12/tty,web))" },
    { "input": "h(tty,@12/tty)", "accept": true, "expect": "h(tty,@12/tty)" },
    { "input": "h(web,@12/web)", "accept": true, "expect": "h(web,@12/web)" },
    { "input": "h(code,@3/code)", "accept": true, "expect": "h(code,@3/code)" },
    { "input": "h(tty,@12/code)", "accept": true, "expect": "h(tty,@12/code)" },
    { "input": "h(tty,@3/tty,@4/code)", "accept": true, "expect": "h(tty,@3/tty,@4/code)" },
    { "input": "h(tty,tty)", "accept": true, "expect": "h(tty,tty)" },
    { "input": "h(tty,tty,@12/tty)", "accept": true, "owner": "@7", "expect": "h(tty,tty,@12/tty)" },
    { "input": "h(tty,tty,@3/tty,@4/tty)", "accept": true, "expect": "h(tty,tty,@3/tty,@4/tty)" },
    { "input": "h(tty,@7/tty)", "accept": true, "expect": "h(tty,@7/tty)" },
    { "input": "v(h(tty,code,web),h(@3/tty,@4/tty,@5/code))", "accept": true, "expect": "v(h(tty,code,web),h(@3/tty,@4/tty,@5/code))" },
    { "input": "split-h:tty,web", "accept": true, "expect": "h(tty,web)" },
    { "input": "h(tty,@12/web/2)", "accept": false },
    { "input": "h(tty,web/2)", "accept": false },
    { "input": "h(tty,tty/2)", "accept": false },
    { "input": "h(tty,-L x @12/tty)", "accept": false },
    { "input": "h(tty,-L srv @12/tty)", "accept": false },
    { "input": "h(tty,=s:@12/tty)", "accept": false },
    { "input": "h(tty,@12/tty,@12/tty)", "accept": false },
    { "input": "h(tty,@12/gui)", "accept": false },
    { "input": "@7/gui", "accept": false },
    { "input": "h(tty,@7/tty)", "accept": false, "owner": "@7" },
    { "input": "h(web,web)", "accept": false },
    { "input": "h(gui,gui)", "accept": false },
    { "input": "split-h:tty,@3/tty", "accept": false },
    { "input": "h(tty,@12)", "accept": false },
    { "input": "h(tty,@x/tty)", "accept": false },
    { "input": "h(tty,@12/)", "accept": false },
    { "input": "h(tty,@12/tty/2/x)", "accept": false },
    { "input": "h(tty,@12/tty/)", "accept": false },
    { "input": "h(tty,@12/foo)", "accept": false },
    { "input": "h(tty,@/tty)", "accept": false }
  ]
