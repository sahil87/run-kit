{
  "name": "run-kit-desktop",
  "version": "0.0.0",
  "private": true,
  "description": "run-kit desktop viewer shell — loads an existing rk serve URL (client only, never spawns or supervises the daemon)",
  "homepage": "https://github.com/sahil87/run-kit",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "compile": "tsc && node -e \"for(const page of ['welcome','interstitial']){fs.mkdirSync('dist/'+page,{recursive:true});fs.copyFileSync('src/'+page+'/'+page+'.html','dist/'+page+'/'+page+'.html')}\"",
    "test": "node --test \"dist/**/*.test.js\"",
    "dev": "pnpm run compile && electron ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller"
    ]
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  }
}
