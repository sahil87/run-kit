# run-kit port policy — the ONE source of truth for reserved/default ports.
# Read by: Go (internal/portpolicy, //go:embed), scripts/e2e-env.sh +
# scripts/test-e2e.sh (sourced), Playwright helpers (parsed).
# Machine-only ports live in a 5-digit block humans never type.

# Daemon default (Vite/serve port). Dev backend = +1, code-server = +2.
PORTPOLICY_DAEMON_DEFAULT=3000
# Pre-rename daemon default. Existing installs are pinned here (config.yaml
# `port`) through the HexoKit rename so remote access keeps working; only
# fresh installs take PORTPOLICY_DAEMON_DEFAULT once it moves. This constant —
# never RK_PORT or DAEMON_DEFAULT — is the pin's source.
PORTPOLICY_DAEMON_LEGACY=3000
# e2e rig block: 100 triples (Vite, Go backend, code-server stub).
PORTPOLICY_RIG_START=21000
PORTPOLICY_RIG_END=21299
# rk remote SSH-tunnel local ports (persisted in remotes.yaml).
# Rule P targets 21500-21599, but a one-shot reassignment of persisted
# local_ports is deferred: local_port is immutable by design (it keys
# per-origin browser state and the desktop shell's persistent view identity),
# live `ssh -L` tunnels would orphan on the old port, and remote.Load rejects
# out-of-range entries. A later change may assign new remotes from 21500+
# while grandfathering existing entries.
PORTPOLICY_TUNNEL_START=3100
PORTPOLICY_TUNNEL_END=3199
# Playwright fail-closed sentinel: a bare `playwright test` connects here and finds nothing.
PORTPOLICY_SENTINEL=21999
